# Copy this file to .env on a machine that will make a user-authorized
# provider call. Never commit .env. The values below are empty on purpose.

# Required only for python -m parallax.experiment --live,
# python -m parallax.xray --live, python -m parallax.controls --live,
# python -m parallax.live --live, and python -m parallax.live_pair --live.
# Offline tests, dry-runs, the dashboard, and the scripted BYOA examples
# do not need a key. Dry-runs of the research CLIs may load this file
# and will not print the key.
OPENAI_API_KEY=

# Model id sent on a live call. The recorded studies used gpt-6-luna.
# Leave this empty if you are not making a live call.
PARALLAX_MODEL=

# Optional ceilings. Integers of at least 1. Defaults are 4 and 6.
# PARALLAX_MAX_MODEL_CALLS=4
# PARALLAX_MAX_TOOL_CALLS=6
